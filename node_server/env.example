NODE_ENV=development
PORT=8000
DOMAIN_NAME=http://localhost:8000

DATABASE_URL=postgresql://user:password@localhost:5432/neuranexus
REDIS_URL=redis://localhost:6379
PYTHON_SERVER_URL=http://localhost:5000

JWT_ACCESS_SECRET=replace_with_at_least_32_random_bytes
JWT_REFRESH_SECRET=replace_with_a_different_32_byte_secret
INGESTION_SERVICE_TOKEN=replace_with_shared_node_python_secret
CORS_ORIGINS=http://localhost:3000

IMAGE_MAX_SIZE=10
AUDIO_MAX_SIZE=50
PDF_MAX_SIZE=50
DOCUMENT_MAX_SIZE=25
DEFAULT_IMAGE_WIDTH=800
DEFAULT_IMAGE_HEIGHT=600
DEFAULT_IMAGE_QUALITY=80
QUERY_REQUEST_TIMEOUT_MS=120000

RAG_ACTIVE_INDEX_VERSION=gemini-embed-001-768-v1
