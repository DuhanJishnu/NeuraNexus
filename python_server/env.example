# Copy to .env and replace every secret placeholder.
GEMINI_API_KEY=replace_with_secret_manager_value
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBED_BATCH_SIZE=32
GEMINI_TIMEOUT_MS=60000
GEMINI_MAX_RETRIES=5
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
RERANKER_ENABLED=false

API_URL=http://localhost:8000
INGESTION_SERVICE_TOKEN=replace_with_shared_service_secret
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

INDEX_VERSION=gemini-embed-001-768-v1
UPSTASH_VECTOR_REST_URL=https://replace-with-index-url
UPSTASH_VECTOR_REST_TOKEN=replace_with_upstash_secret
VECTOR_INDEXES_JSON='{"gemini-embed-001-768-v1":{"url":"https://replace-with-index-url","token":"replace_with_upstash_secret","hybrid":false}}'
HYBRID_SEARCH_ENABLED=false
SPARSE_HASH_DIMENSIONS=2147483647
HYBRID_DENSE_WEIGHT=1.0
HYBRID_SPARSE_WEIGHT=1.0

LEASE_HEARTBEAT_SECONDS=120
